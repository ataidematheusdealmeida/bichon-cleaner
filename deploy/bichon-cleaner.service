[Unit]
Description=Bichon Cleaner IMAP retention worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/bichon-cleaner
Environment=CLEANER_ROOT=/opt/bichon-cleaner
Environment=BICHON_DATA=/opt/bichon/data
Environment=BICHON_URL=http://127.0.0.1:15630
ExecStart=/opt/bichon-cleaner/.venv/bin/python /opt/bichon-cleaner/worker.py
UMask=0077
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/bichon-cleaner/state
